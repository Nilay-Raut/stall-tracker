# Copy to .env.local for development. Never commit real values.

# Postgres connection. Matches docker-compose.yml for local development.
DATABASE_URL=postgres://stall:stall_dev_password@127.0.0.1:5432/stall

# Closing-time reminder (optional). Without these the reminder switch says it is not set up.
# Make them with: node scripts/generate-secrets.mjs CRON_SECRET VAPID_PUBLIC_KEY
# On the server, deploy.sh creates them automatically.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
